# Copy to .env.local to change it. Where the backend API runs; a trailing slash is fine.
# Default when unset: http://127.0.0.1:8000. Use 127.0.0.1, not localhost: uvicorn listens on IPv4
# only, and "localhost" can resolve to ::1 first. On Vercel (T13): the Render URL.
VITE_API_URL=http://127.0.0.1:8000
