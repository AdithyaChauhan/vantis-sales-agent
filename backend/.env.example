# Copy to backend/.env and fill in. Never commit .env.
# Render: render.yaml (repo root) sets the same variables; the secrets go into Render's form
# (docs/DEPLOY.md). Plain values must match render.yaml (tests/test_deploy_config.py).

# Neon direct (non-pooled) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: a Neon branch named "test". DB tests skip if empty
TEST_DATABASE_URL=

# Gemini key (AI Studio)
GOOGLE_API_KEY=
# Pick model names from: python -m scripts.list_models
# Free tier: Gemini Flash models allow 20 requests/day; the two Flash-Lite models below allow
# 15/min and 500/day each (separate quota per model)
LLM_MODEL_MAIN=gemini-3.5-flash-lite
LLM_MODEL_FAST=gemini-3.1-flash-lite
# Gemini service tier for chat calls: standard (default; nothing is sent), priority (only for Tier 2/3 paid projects,
# priced about 75-100% above standard; overflow is served as standard) or flex (cheaper, slower)
GEMINI_SERVICE_TIER=standard
# Free tier: 100/min, 30K tokens/min, 1,000/day
EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector column size
EMBEDDING_DIM=768
# Retrieval relevance gate: below this best cosine similarity there is no context
# (KB questions scored 0.68-0.84, off-topic ones 0.49-0.58; see docs/EVAL.md)
RETRIEVAL_MIN_SIMILARITY=0.63

# Fallback LLM (Groq). Use a model that supports tool calling and reasoning_effort (gpt-oss does;
# llm.py sends reasoning_effort=low). Free tier: 30/min, 1,000/day, 8K tokens/min
GROQ_API_KEY=
FALLBACK_MODEL=openai/gpt-oss-120b
# A second Groq model for answers, tried after FALLBACK_MODEL (T13d). Groq limits each model separately, so it has its
# own 8K tokens/min and 1,000 requests/day (checked on our key). Must support tool calling and reasoning_effort, like
# gpt-oss. Leave empty for none
FALLBACK_MODEL_2=openai/gpt-oss-20b

# Shared key for sales endpoints and the dashboard (X-API-Key header). At least 16 characters, or the
# sales endpoints refuse every request. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SALES_API_KEY=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Header a trusted proxy sets with the real client IP. Empty locally (the connection address is used);
# Render sets CF-Connecting-IP. Never X-Forwarded-For: callers can put anything at its start.
CLIENT_IP_HEADER=
# /api/chat messages per client IP (PLAN.md part 3.11 explains the numbers)
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=100

# KB PDF path, resolved from the repo root. Ingestion only
KB_PATH=data/kb/Vantis_Energy_Solutions_Knowledge_Base.pdf
LOG_LEVEL=INFO

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vantis-sales-agent
# Hide parts of every trace from LangSmith (langsmith 0.14.7 reads these; only "true" hides).
# Turn inputs and outputs on before tracing real customer chats (personal details).
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
LANGSMITH_HIDE_METADATA=false

# Lead status and score in /api/chat's `lead` field (chat page demo panel). Set false in production:
# the chat is customer-facing.
CHAT_SHOW_LEAD_SCORE=true
