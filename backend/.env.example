# Copy to backend/.env and fill in. Never commit .env.
# Render: render.yaml (repo root) sets the same variables; the secrets go into Render's form
# (docs/DEPLOY.md). Plain values must match render.yaml (tests/test_deploy_config.py).

# Neon direct (non-pooled) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: a Neon branch named "test". DB tests skip if empty
TEST_DATABASE_URL=

# Gemini key (AI Studio)
GOOGLE_API_KEY=
# Pick model names from: python -m scripts.list_models
# Free tier: Gemini Flash models allow 20 requests/day; the two Flash-Lite models below allow
# 15/min and 500/day each (separate quota per model)
LLM_MODEL_MAIN=gemini-3.5-flash-lite
LLM_MODEL_FAST=gemini-3.1-flash-lite
# Free tier: 100/min, 30K tokens/min, 1,000/day
EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector column size
EMBEDDING_DIM=768
# Retrieval relevance gate: below this best cosine similarity there is no context
# (KB questions scored 0.68-0.84, off-topic ones 0.49-0.58; see docs/EVAL.md)
RETRIEVAL_MIN_SIMILARITY=0.63

# Fallback LLM (Groq). Use a model that supports tool calling and reasoning_effort (gpt-oss does;
# llm.py sends reasoning_effort=low). Free tier: 30/min, 1,000/day, 8K tokens/min
GROQ_API_KEY=
FALLBACK_MODEL=openai/gpt-oss-120b

# Shared key for sales endpoints and the dashboard
SALES_API_KEY=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# KB PDF path, resolved from the repo root. Ingestion only
KB_PATH=data/kb/Vantis_Energy_Solutions_Knowledge_Base.pdf
LOG_LEVEL=INFO

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vantis-sales-agent
