# Copy to backend/.env and fill in. Never commit .env.

# Neon direct (non-pooled) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: a Neon branch named "test". DB tests skip if empty
TEST_DATABASE_URL=

# Gemini key (AI Studio)
GOOGLE_API_KEY=
# Pick model names from: python -m scripts.list_models
LLM_MODEL_MAIN=
LLM_MODEL_FAST=
EMBEDDING_MODEL=
# Must match the vector column size
EMBEDDING_DIM=768

# Fallback LLM (Groq). Use a model that supports tool calling
GROQ_API_KEY=
FALLBACK_MODEL=

# Shared key for sales endpoints and the dashboard
SALES_API_KEY=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# KB PDF path, resolved from the repo root. Ingestion only
KB_PATH=data/kb/Vantis_Energy_Solutions_Knowledge_Base.pdf
LOG_LEVEL=INFO

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vantis-sales-agent
